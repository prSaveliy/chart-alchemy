# Set to "development" locally to disable SSL on the database connection.
NODE_ENV=development

PORT=3000

JWT_SECRET=

DATABASE_URL="postgresql://userexample:example@localhost:5432/exampledb?schema=public"
REDIS_URL=redis://localhost:6379

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

API_URL=http://localhost:3000
CLIENT_API_URL=http://localhost:5173

# Comma-separated list of allowed CORS origins (e.g. http://localhost:5173,https://chartalchemy.app)
CORS_ORIGIN=

# if accessing gemini api through vertex ai
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# if accessing gemini api through google ai studio
GEMINI_API_KEY=
# 2 comma-separated gemini model names (thinkingModel,standardModel)
GEMINI_MODELS=gemini-3.1-pro-preview,gemini-3-flash-preview

# vertex ai configuration
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_GENAI_USE_VERTEXAI=
    